<?xml version="1.0" encoding="UTF-8"?>
<?import java.net.URL?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="gui.PromotionsController"
      styleClass="screen-bg"
      spacing="0"
      prefWidth="720" prefHeight="620">

    <stylesheets>
        <URL value="@gonature.css"/>
    </stylesheets>

    <!-- Header bar -->
    <HBox styleClass="header-bar" alignment="CENTER_LEFT" spacing="10">
        <Label text="🌿 GoNature — Promotions" styleClass="header-logo"/>
        <Region HBox.hgrow="ALWAYS"/>
        <Button fx:id="btnTheme" text="🌙" styleClass="btn-outline"/>
        <Button text="Close" onAction="#handleClose" styleClass="btn-outline"/>
    </HBox>

    <ScrollPane fitToWidth="true" styleClass="scroll-pane" VBox.vgrow="ALWAYS">
        <VBox spacing="18" style="-fx-padding: 24;">

            <Label fx:id="lblParkName" styleClass="screen-title"/>

            <!-- New promotion card -->
            <VBox spacing="14" styleClass="card">
                <Label text="🎉  Create a Promotion" styleClass="card-title"/>
                <Label text="Promotions need department manager approval before they go live."
                       styleClass="lbl-hint" wrapText="true"/>
                <Separator/>

                <VBox spacing="4">
                    <Label text="Description" styleClass="field-label"/>
                    <TextField fx:id="txtDescription" promptText="e.g. Summer Special — 15% off all visits"
                               maxWidth="Infinity"/>
                </VBox>

                <HBox spacing="16">
                    <VBox spacing="4" HBox.hgrow="ALWAYS">
                        <Label text="Discount (%)" styleClass="field-label"/>
                        <TextField fx:id="txtDiscount" promptText="1–50" maxWidth="Infinity"/>
                        <Label text="Whole number between 1 and 50." styleClass="lbl-hint"/>
                    </VBox>
                    <VBox spacing="4" HBox.hgrow="ALWAYS">
                        <Label text="Start Date" styleClass="field-label"/>
                        <DatePicker fx:id="dpStart" maxWidth="Infinity"/>
                    </VBox>
                    <VBox spacing="4" HBox.hgrow="ALWAYS">
                        <Label text="End Date" styleClass="field-label"/>
                        <DatePicker fx:id="dpEnd" maxWidth="Infinity"/>
                    </VBox>
                </HBox>

                <Label fx:id="lblStatus" text="" wrapText="true" maxWidth="Infinity"
                       style="-fx-font-size:13px;"/>

                <Button text="📤  Submit for Approval" maxWidth="Infinity"
                        onAction="#handleSubmit"
                        styleClass="btn-blue" style="-fx-padding:8 14; -fx-font-size:13px;"/>
            </VBox>

            <!-- Existing promotions -->
            <VBox spacing="10" styleClass="card">
                <HBox alignment="CENTER_LEFT" spacing="10">
                    <Label text="📋  My Park's Promotions" styleClass="card-title"/>
                    <Region HBox.hgrow="ALWAYS"/>
                    <Button text="🔄  Refresh" onAction="#handleRefresh"
                            styleClass="btn-teal"
                            style="-fx-font-size:12px; -fx-padding:6 14; -fx-background-radius:8;"/>
                </HBox>
                <Separator/>
                <TableView fx:id="tablePromotions" prefHeight="240" styleClass="table-view">
                    <columns>
                        <TableColumn fx:id="colDescription" text="Description" prefWidth="270"/>
                        <TableColumn fx:id="colDiscount"    text="Discount"    prefWidth="90"/>
                        <TableColumn fx:id="colDates"       text="Valid"       prefWidth="200"/>
                        <TableColumn fx:id="colStatus"      text="Status"      prefWidth="110"/>
                    </columns>
                </TableView>
            </VBox>

        </VBox>
    </ScrollPane>
</VBox>
