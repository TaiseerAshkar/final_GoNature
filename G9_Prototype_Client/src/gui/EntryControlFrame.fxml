<?xml version="1.0" encoding="UTF-8"?>
<?import java.net.URL?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="gui.EntryControlController"
      styleClass="screen-bg"
      spacing="0"
      prefWidth="840" prefHeight="620">

    <stylesheets>
        <URL value="@gonature.css"/>
    </stylesheets>

    <!-- Header -->
    <HBox styleClass="header-bar" alignment="CENTER_LEFT" spacing="10">
        <Label text="🌿 GoNature — Entry Control" styleClass="header-logo"/>
        <Region HBox.hgrow="ALWAYS"/>
        <Label fx:id="lblParkName" styleClass="header-badge"/>
        <Button text="Close" onAction="#handleClose" styleClass="btn-outline"/>
    </HBox>

    <!-- Tab pane -->
    <TabPane VBox.vgrow="ALWAYS" tabClosingPolicy="UNAVAILABLE">

        <!-- TAB 1: CHECK-IN -->
        <Tab text="  ✅  Check-In Visitor  ">
            <ScrollPane fitToWidth="true" styleClass="scroll-pane">
                <VBox spacing="14" style="-fx-padding: 20;">

                    <!-- Input card -->
                    <VBox spacing="10" styleClass="card">
                        <Label text="Visitor Lookup" styleClass="card-title"/>
                        <Separator/>
                        <HBox spacing="12" alignment="CENTER_LEFT">
                            <VBox spacing="4">
                                <Label text="Visitor ID *" styleClass="field-label"/>
                                <TextField fx:id="txtVisitorId" prefWidth="145"
                                           promptText="Government ID"/>
                            </VBox>
                            <VBox spacing="4">
                                <Label text="Park *" styleClass="field-label"/>
                                <ComboBox fx:id="cboPark" prefWidth="165"
                                          promptText="Select Park"/>
                            </VBox>
                            <VBox spacing="4">
                                <Label text="Visitors" styleClass="field-label"/>
                                <TextField fx:id="txtWalkInVisitors" prefWidth="58" text="1"/>
                            </VBox>
                            <VBox spacing="4">
                                <Label text="Type" styleClass="field-label"/>
                                <ComboBox fx:id="cboOrderType" prefWidth="130"/>
                            </VBox>
                            <Region HBox.hgrow="ALWAYS"/>
                            <VBox alignment="BOTTOM_RIGHT" spacing="0">
                                <Label text=" " styleClass="field-label"/>
                                <HBox spacing="8">
                                    <Button text="📷  Scan QR" onAction="#handleScanQRCode"
                                            styleClass="btn-outline"/>
                                    <Button fx:id="btnCheckIn" text="✅  Check In"
                                            onAction="#handleCheckIn" styleClass="btn-primary"/>
                                </HBox>
                            </VBox>
                        </HBox>
                        <!-- Visitor count rule hint — updated dynamically when type changes -->
                        <Label fx:id="lblVisitorHint"
                               text="Individual: exactly 1 visitor. Count is fixed automatically."
                               styleClass="lbl-hint" wrapText="true"
                               style="-fx-font-style: italic;"/>
                        <Label text="For pre-booked visitors, count and type are auto-filled from their booking."
                               styleClass="lbl-hint" wrapText="true"/>
                    </VBox>

                    <!-- Feedback message -->
                    <Label fx:id="lblCheckInMessage" text="" wrapText="true"
                           styleClass="lbl-error" maxWidth="800"/>

                    <!-- Result card -->
                    <VBox fx:id="paneResult" visible="false" managed="false"
                          spacing="10" styleClass="card">

                        <!-- Status banner -->
                        <HBox fx:id="bannerBox" spacing="10" alignment="CENTER_LEFT"
                              styleClass="banner-confirmed"
                              style="-fx-padding: 10 14; -fx-background-radius: 6;">
                            <Label fx:id="lblResultStatus" styleClass="banner-text"/>
                        </HBox>

                        <!-- Detail grid — column 1 has minWidth so labels never collapse -->
                        <GridPane hgap="20" vgap="8" style="-fx-padding: 4 0;">
                            <columnConstraints>
                                <ColumnConstraints minWidth="100" prefWidth="110"/>
                                <ColumnConstraints minWidth="180" prefWidth="340" hgrow="ALWAYS"/>
                            </columnConstraints>

                            <Label text="Order #:"    styleClass="lbl-detail-key"
                                   GridPane.rowIndex="0" GridPane.columnIndex="0"/>
                            <Label fx:id="lblResultOrderId"
                                   style="-fx-font-size: 13px; -fx-text-fill: #1A1A1A;"
                                   GridPane.rowIndex="0" GridPane.columnIndex="1"/>

                            <Label text="Visitor ID:" styleClass="lbl-detail-key"
                                   GridPane.rowIndex="1" GridPane.columnIndex="0"/>
                            <Label fx:id="lblResultVisitorId"
                                   style="-fx-font-size: 13px; -fx-text-fill: #1A1A1A;"
                                   GridPane.rowIndex="1" GridPane.columnIndex="1"/>

                            <Label text="Park:"       styleClass="lbl-detail-key"
                                   GridPane.rowIndex="2" GridPane.columnIndex="0"/>
                            <Label fx:id="lblResultPark"
                                   style="-fx-font-size: 13px; -fx-text-fill: #1A1A1A;"
                                   GridPane.rowIndex="2" GridPane.columnIndex="1"/>

                            <Label text="Visitors:"   styleClass="lbl-detail-key"
                                   GridPane.rowIndex="3" GridPane.columnIndex="0"/>
                            <Label fx:id="lblResultVisitors"
                                   style="-fx-font-size: 13px; -fx-text-fill: #1A1A1A;"
                                   GridPane.rowIndex="3" GridPane.columnIndex="1"/>

                            <Label text="Order Type:" styleClass="lbl-detail-key"
                                   GridPane.rowIndex="4" GridPane.columnIndex="0"/>
                            <Label fx:id="lblResultType"
                                   style="-fx-font-size: 13px; -fx-text-fill: #1A1A1A;"
                                   GridPane.rowIndex="4" GridPane.columnIndex="1"/>
                        </GridPane>

                        <Separator/>

                        <!-- Payment -->
                        <HBox spacing="10" alignment="CENTER_LEFT">
                            <Label text="Payment Due:"
                                   style="-fx-font-weight: bold; -fx-font-size: 14px; -fx-text-fill: #212121;"/>
                            <Label fx:id="lblResultPayment"
                                   style="-fx-font-size: 22px; -fx-font-weight: bold; -fx-text-fill: #2E7D32;"/>
                        </HBox>
                        <Label fx:id="lblResultNote" styleClass="lbl-hint" wrapText="true"/>
                    </VBox>

                </VBox>
            </ScrollPane>
        </Tab>

        <!-- TAB 2: REGISTER EXIT -->
        <Tab text="  🚪  Register Exit  ">
            <VBox spacing="14" style="-fx-padding: 20;">

                <!-- Input card -->
                <VBox spacing="10" styleClass="card">
                    <Label text="Visitor Exit Registration" styleClass="card-title"/>
                    <Separator/>
                    <HBox spacing="12" alignment="CENTER_LEFT">
                        <VBox spacing="4">
                            <Label text="Visitor ID *" styleClass="field-label"/>
                            <TextField fx:id="txtExitVisitorId" prefWidth="180"
                                       promptText="Government ID"/>
                        </VBox>
                        <VBox spacing="4">
                            <Label text="Park *" styleClass="field-label"/>
                            <ComboBox fx:id="cboExitPark" prefWidth="165"
                                      promptText="Select Park"/>
                        </VBox>
                        <Region HBox.hgrow="ALWAYS"/>
                        <VBox alignment="BOTTOM_RIGHT">
                            <Label text=" " styleClass="field-label"/>
                            <Button text="🚪  Register Exit" onAction="#handleRegisterExit"
                                    styleClass="btn-warning"/>
                        </VBox>
                    </HBox>
                    <Label text="Records the visitor's exit time. Only visitors who checked in today at the selected park are valid."
                           styleClass="lbl-hint" wrapText="true"/>
                </VBox>

                <!-- Result message -->
                <Label fx:id="lblExitMessage" text="" wrapText="true"
                       styleClass="lbl-success" maxWidth="800"/>

            </VBox>
        </Tab>

    </TabPane>
</VBox>
