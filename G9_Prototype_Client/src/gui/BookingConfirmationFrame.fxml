<?xml version="1.0" encoding="UTF-8"?>
<?import java.net.URL?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="gui.BookingConfirmationController"
      styleClass="screen-bg"
      alignment="TOP_CENTER" spacing="0"
      prefWidth="520" prefHeight="780">

    <stylesheets>
        <URL value="@gonature.css"/>
    </stylesheets>

    <!-- ── Header bar ──────────────────────────────────────────── -->
    <HBox styleClass="header-bar" alignment="CENTER_LEFT" spacing="10">
        <Label text="🌿 GoNature" styleClass="header-logo"/>
        <Region HBox.hgrow="ALWAYS"/>
        <Label text="Reservation System" styleClass="header-subtitle"/>
        <Button fx:id="btnTheme" text="🌙" styleClass="btn-outline"/>
    </HBox>

    <!-- ── Scrollable body ─────────────────────────────────────── -->
    <ScrollPane fitToWidth="true" styleClass="scroll-pane" VBox.vgrow="ALWAYS">
        <VBox spacing="20" style="-fx-padding: 28 28 40 28;" alignment="TOP_CENTER">

            <!-- ── Status hero banner (gradient supplied by the styleClass) ── -->
            <VBox fx:id="bannerBox" alignment="CENTER" spacing="10" maxWidth="464"
                  styleClass="banner-confirmed"
                  style="-fx-padding: 30 28 26 28; -fx-background-radius: 16;">

                <!-- large icon -->
                <Label fx:id="lblStatusIcon"
                       style="-fx-font-size: 48px; -fx-text-fill: white;"/>

                <!-- title -->
                <Label fx:id="lblStatusTitle"
                       style="-fx-font-size: 22px; -fx-font-weight: bold;
                              -fx-text-fill: white;"/>

                <!-- order reference pill -->
                <Label fx:id="lblBookingId"
                       style="-fx-font-size: 12px; -fx-text-fill: rgba(255,255,255,0.90);
                              -fx-background-color: rgba(0,0,0,0.20);
                              -fx-background-radius: 20; -fx-padding: 5 16 5 16;
                              -fx-font-weight: bold;"/>
            </VBox>

            <!-- ── Entry Pass (ticket) ──────────────────────────── -->
            <VBox fx:id="paneEntryPass" spacing="0" maxWidth="464"
                  visible="false" managed="false"
                  style="-fx-background-color: -park-surface; -fx-background-radius: 12;
                         -fx-effect: dropshadow(gaussian, rgba(31,61,43,0.16), 16, 0, 0, 4);
                         -fx-border-color: -park-sage-2; -fx-border-width: 1;
                         -fx-border-radius: 12;">

                <!-- Ticket header strip (pine) -->
                <HBox alignment="CENTER_LEFT" spacing="10"
                      style="-fx-background-color: linear-gradient(to right, -park-pine-dark, -park-pine);
                             -fx-background-radius: 12 12 0 0; -fx-padding: 13 18;">
                    <Label text="🎫"
                           style="-fx-font-size: 16px;"/>
                    <Label text="ENTRY PASS"
                           style="-fx-font-size: 12px; -fx-font-weight: bold;
                                  -fx-text-fill: white;"/>
                    <Region HBox.hgrow="ALWAYS"/>
                    <Label text="VALID · ONE VISIT"
                           style="-fx-font-size: 10px; -fx-text-fill: rgba(255,255,255,0.75);
                                  -fx-background-color: rgba(0,0,0,0.20);
                                  -fx-background-radius: 10; -fx-padding: 3 8;"/>
                </HBox>

                <!-- Perforation strip -->
                <HBox alignment="CENTER"
                      style="-fx-background-color: -park-sage; -fx-padding: 3 0;">
                    <Label text="╌ ╌ ╌ ╌ ╌ ╌ ╌ ╌ ╌ ╌ ╌ ╌ ╌ ╌ ╌ ╌ ╌ ╌ ╌ ╌ ╌ ╌ ╌ ╌ ╌ ╌ ╌ ╌"
                           style="-fx-text-fill: -park-sage-2; -fx-font-size: 11px;"/>
                </HBox>

                <!-- QR + reference body -->
                <VBox alignment="CENTER" spacing="14"
                      style="-fx-padding: 22 20 20 20;">
                    <VBox fx:id="paneQR" alignment="CENTER" spacing="0"/>
                    <Label fx:id="lblEntryCode" wrapText="true" maxWidth="Infinity"
                           style="-fx-font-size: 12px; -fx-font-weight: bold;
                                  -fx-text-fill: -park-pine; -fx-alignment: center;
                                  -fx-text-alignment: center;
                                  -fx-background-color: -park-sage;
                                  -fx-background-radius: 8; -fx-padding: 9 14;"/>
                    <Label text="📱  Present this QR code or quote the entry number at the gate."
                           wrapText="true" maxWidth="Infinity"
                           style="-fx-font-size: 11px; -fx-text-fill: -park-text-muted;
                                  -fx-text-alignment: center; -fx-alignment: center;"/>
                </VBox>
            </VBox>

            <!-- ── Booking Details card ─────────────────────────── -->
            <VBox spacing="0" maxWidth="464"
                  style="-fx-background-color: -park-surface; -fx-background-radius: 12;
                         -fx-effect: dropshadow(gaussian, rgba(31,61,43,0.08), 14, 0, 0, 3);
                         -fx-border-color: -park-line; -fx-border-width: 1;
                         -fx-border-radius: 12;">

                <!-- Card title bar -->
                <HBox alignment="CENTER_LEFT" spacing="8"
                      style="-fx-padding: 14 18 13 18;
                             -fx-border-color: transparent transparent -park-line transparent;
                             -fx-border-width: 0 0 1.5 0;">
                    <Label text="📋"
                           style="-fx-font-size: 14px;"/>
                    <Label text="Booking Details"
                           style="-fx-font-size: 15px; -fx-font-weight: bold;
                                  -fx-text-fill: -park-pine;"/>
                </HBox>

                <!-- Detail rows -->

                <!-- Park -->
                <HBox alignment="CENTER_LEFT" spacing="0"
                      style="-fx-padding: 11 18; -fx-background-color: -park-surface;">
                    <Label text="🏕  PARK"
                           style="-fx-font-size: 11px; -fx-font-weight: bold;
                                  -fx-text-fill: -park-text-muted; -fx-min-width: 100;"/>
                    <Label fx:id="lblPark" wrapText="true" HBox.hgrow="ALWAYS"
                           style="-fx-font-size: 13px; -fx-font-weight: bold;
                                  -fx-text-fill: -park-text;"/>
                </HBox>

                <!-- Date + Time (same row) -->
                <HBox alignment="CENTER_LEFT" spacing="0"
                      style="-fx-padding: 11 18; -fx-background-color: -park-surface-2;">
                    <Label text="📅  DATE"
                           style="-fx-font-size: 11px; -fx-font-weight: bold;
                                  -fx-text-fill: -park-text-muted; -fx-min-width: 100;"/>
                    <Label fx:id="lblDate"
                           style="-fx-font-size: 13px; -fx-text-fill: -park-text;
                                  -fx-min-width: 120;"/>
                    <Label text="🕐  TIME"
                           style="-fx-font-size: 11px; -fx-font-weight: bold;
                                  -fx-text-fill: -park-text-muted; -fx-min-width: 80;
                                  -fx-padding: 0 0 0 8;"/>
                    <Label fx:id="lblTime"
                           style="-fx-font-size: 13px; -fx-text-fill: -park-text;"/>
                </HBox>

                <!-- Visitors + Type (same row) -->
                <HBox alignment="CENTER_LEFT" spacing="0"
                      style="-fx-padding: 11 18; -fx-background-color: -park-surface;">
                    <Label text="👥  VISITORS"
                           style="-fx-font-size: 11px; -fx-font-weight: bold;
                                  -fx-text-fill: -park-text-muted; -fx-min-width: 100;"/>
                    <Label fx:id="lblVisitors"
                           style="-fx-font-size: 13px; -fx-text-fill: -park-text;
                                  -fx-min-width: 120;"/>
                    <Label text="🏷  TYPE"
                           style="-fx-font-size: 11px; -fx-font-weight: bold;
                                  -fx-text-fill: -park-text-muted; -fx-min-width: 80;
                                  -fx-padding: 0 0 0 8;"/>
                    <Label fx:id="lblType"
                           style="-fx-font-size: 13px; -fx-text-fill: -park-text;"/>
                </HBox>

                <!-- Email -->
                <HBox alignment="CENTER_LEFT" spacing="0"
                      style="-fx-padding: 11 18; -fx-background-color: -park-surface-2;">
                    <Label text="✉  EMAIL"
                           style="-fx-font-size: 11px; -fx-font-weight: bold;
                                  -fx-text-fill: -park-text-muted; -fx-min-width: 100;"/>
                    <Label fx:id="lblEmail" wrapText="true" HBox.hgrow="ALWAYS"
                           style="-fx-font-size: 13px; -fx-text-fill: -park-text;"/>
                </HBox>

                <!-- Note footer -->
                <HBox style="-fx-padding: 11 18 14 18;
                             -fx-border-color: -park-line transparent transparent transparent;
                             -fx-border-width: 1.5 0 0 0;
                             -fx-background-color: -park-surface-2;
                             -fx-background-radius: 0 0 12 12;">
                    <Label fx:id="lblEmailNote" wrapText="true" HBox.hgrow="ALWAYS"
                           style="-fx-font-size: 11.5px; -fx-text-fill: -park-text-mid;
                                  -fx-font-style: italic;"/>
                </HBox>
            </VBox>

            <!-- ── Promotion price card (only shown when a promotion is active) ── -->
            <VBox fx:id="panePromo" spacing="0" maxWidth="464"
                  visible="false" managed="false"
                  style="-fx-background-color: -park-surface; -fx-background-radius: 12;
                         -fx-effect: dropshadow(gaussian, rgba(31,61,43,0.08), 14, 0, 0, 3);
                         -fx-border-color: -park-gold; -fx-border-width: 1.5;
                         -fx-border-radius: 12;">

                <!-- Gold header strip -->
                <HBox alignment="CENTER_LEFT" spacing="8"
                      style="-fx-background-color: linear-gradient(to right, -park-gold-700, -park-gold);
                             -fx-background-radius: 12 12 0 0; -fx-padding: 12 18;">
                    <Label text="🎉"
                           style="-fx-font-size: 15px;"/>
                    <Label fx:id="lblPromoTag" text="Promotion Applied"
                           style="-fx-font-size: 13px; -fx-font-weight: bold; -fx-text-fill: white;"/>
                </HBox>

                <!-- Promotion description -->
                <HBox alignment="CENTER_LEFT"
                      style="-fx-padding: 11 18; -fx-background-color: -park-surface;">
                    <Label fx:id="lblPromoDesc" wrapText="true" HBox.hgrow="ALWAYS"
                           style="-fx-font-size: 12.5px; -fx-text-fill: -park-text;"/>
                </HBox>

                <!-- Price comparison -->
                <HBox alignment="CENTER_LEFT" spacing="0"
                      style="-fx-padding: 11 18 14 18; -fx-background-color: -park-surface-2;
                             -fx-background-radius: 0 0 12 12;
                             -fx-border-color: -park-line transparent transparent transparent;
                             -fx-border-width: 1.5 0 0 0;">
                    <VBox spacing="2">
                        <Label text="ESTIMATED PRICE"
                               style="-fx-font-size: 10px; -fx-font-weight: bold;
                                      -fx-text-fill: -park-text-muted;"/>
                        <Label fx:id="lblPriceOriginal"
                               style="-fx-font-size: 13px; -fx-text-fill: -park-text-muted;"/>
                    </VBox>
                    <Region HBox.hgrow="ALWAYS"/>
                    <VBox spacing="2" alignment="CENTER_RIGHT">
                        <Label text="YOU PAY"
                               style="-fx-font-size: 10px; -fx-font-weight: bold;
                                      -fx-text-fill: -park-gold-900;"/>
                        <Label fx:id="lblPriceFinal"
                               style="-fx-font-size: 19px; -fx-font-weight: bold;
                                      -fx-text-fill: -park-pine;"/>
                    </VBox>
                </HBox>
            </VBox>

            <!-- ── Action buttons ───────────────────────────────── -->
            <VBox spacing="10" maxWidth="464">
                <Button text="✔  Done" maxWidth="Infinity"
                        onAction="#handleDone" styleClass="btn-primary"/>
                <Button text="🏕  Book Another Visit" maxWidth="Infinity"
                        onAction="#handleBookAnother" styleClass="btn-teal"/>
            </VBox>

        </VBox>
    </ScrollPane>
</VBox>
