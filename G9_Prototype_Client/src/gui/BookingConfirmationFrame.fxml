<?xml version="1.0" encoding="UTF-8"?>
<?import java.net.URL?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="gui.BookingConfirmationController"
      styleClass="screen-bg"
      alignment="TOP_CENTER" spacing="0"
      prefWidth="520" prefHeight="780">

    <stylesheets>
        <URL value="@gonature.css"/>
    </stylesheets>

    <!-- ── Header bar ──────────────────────────────────────────── -->
    <HBox styleClass="header-bar" alignment="CENTER_LEFT" spacing="10">
        <Label text="🌿 GoNature" styleClass="header-logo"/>
        <Region HBox.hgrow="ALWAYS"/>
        <Label text="Reservation System" styleClass="header-subtitle"/>
    </HBox>

    <!-- ── Scrollable body ─────────────────────────────────────── -->
    <ScrollPane fitToWidth="true" styleClass="scroll-pane" VBox.vgrow="ALWAYS">
        <VBox spacing="20" style="-fx-padding: 28 28 40 28;" alignment="TOP_CENTER">

            <!-- ── Status hero banner ──────────────────────────── -->
            <VBox fx:id="bannerBox" alignment="CENTER" spacing="10" maxWidth="464"
                  styleClass="banner-confirmed"
                  style="-fx-padding: 30 28 26 28; -fx-background-radius: 16;
                         -fx-background-color: linear-gradient(to bottom right, #43A047, #2e7d32);
                         -fx-effect: dropshadow(gaussian, rgba(46,125,50,0.32), 16, 0, 0, 5);">

                <!-- large icon -->
                <Label fx:id="lblStatusIcon"
                       style="-fx-font-size: 48px; -fx-text-fill: white;"/>

                <!-- title -->
                <Label fx:id="lblStatusTitle"
                       style="-fx-font-size: 22px; -fx-font-weight: bold;
                              -fx-text-fill: white;"/>

                <!-- order reference pill -->
                <Label fx:id="lblBookingId"
                       style="-fx-font-size: 12px; -fx-text-fill: rgba(255,255,255,0.90);
                              -fx-background-color: rgba(0,0,0,0.20);
                              -fx-background-radius: 20; -fx-padding: 5 16 5 16;
                              -fx-font-weight: bold;"/>
            </VBox>

            <!-- ── Entry Pass (ticket) ──────────────────────────── -->
            <VBox fx:id="paneEntryPass" spacing="0" maxWidth="464"
                  visible="false" managed="false"
                  style="-fx-background-color: white; -fx-background-radius: 12;
                         -fx-effect: dropshadow(gaussian, rgba(46,125,50,0.16), 16, 0, 0, 4);
                         -fx-border-color: #C8E6C9; -fx-border-width: 1;
                         -fx-border-radius: 12;">

                <!-- Ticket header strip (green) -->
                <HBox alignment="CENTER_LEFT" spacing="10"
                      style="-fx-background-color: linear-gradient(to right, #1B5E20, #2E7D32);
                             -fx-background-radius: 12 12 0 0; -fx-padding: 13 18;">
                    <Label text="🎫"
                           style="-fx-font-size: 16px;"/>
                    <Label text="ENTRY PASS"
                           style="-fx-font-size: 12px; -fx-font-weight: bold;
                                  -fx-text-fill: white;"/>
                    <Region HBox.hgrow="ALWAYS"/>
                    <Label text="VALID · ONE VISIT"
                           style="-fx-font-size: 10px; -fx-text-fill: rgba(255,255,255,0.75);
                                  -fx-background-color: rgba(0,0,0,0.20);
                                  -fx-background-radius: 10; -fx-padding: 3 8;"/>
                </HBox>

                <!-- Perforation strip -->
                <HBox alignment="CENTER"
                      style="-fx-background-color: #F1F8E9; -fx-padding: 3 0;">
                    <Label text="╌ ╌ ╌ ╌ ╌ ╌ ╌ ╌ ╌ ╌ ╌ ╌ ╌ ╌ ╌ ╌ ╌ ╌ ╌ ╌ ╌ ╌ ╌ ╌ ╌ ╌ ╌ ╌"
                           style="-fx-text-fill: #A5D6A7; -fx-font-size: 11px;"/>
                </HBox>

                <!-- QR + reference body -->
                <VBox alignment="CENTER" spacing="14"
                      style="-fx-padding: 22 20 20 20;">
                    <VBox fx:id="paneQR" alignment="CENTER" spacing="0"/>
                    <Label fx:id="lblEntryCode" wrapText="true" maxWidth="Infinity"
                           style="-fx-font-size: 12px; -fx-font-weight: bold;
                                  -fx-text-fill: #1B5E20; -fx-alignment: center;
                                  -fx-text-alignment: center;
                                  -fx-background-color: #E8F5E9;
                                  -fx-background-radius: 8; -fx-padding: 9 14;"/>
                    <Label text="📱  Present this QR code or quote the entry number at the gate."
                           wrapText="true" maxWidth="Infinity"
                           style="-fx-font-size: 11px; -fx-text-fill: #78909C;
                                  -fx-text-alignment: center; -fx-alignment: center;"/>
                </VBox>
            </VBox>

            <!-- ── Booking Details card ─────────────────────────── -->
            <VBox spacing="0" maxWidth="464"
                  style="-fx-background-color: white; -fx-background-radius: 12;
                         -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.08), 14, 0, 0, 3);
                         -fx-border-color: #E8F5E9; -fx-border-width: 1;
                         -fx-border-radius: 12;">

                <!-- Card title bar -->
                <HBox alignment="CENTER_LEFT" spacing="8"
                      style="-fx-padding: 14 18 13 18;
                             -fx-border-color: transparent transparent #E8F5E9 transparent;
                             -fx-border-width: 0 0 1.5 0;">
                    <Label text="📋"
                           style="-fx-font-size: 14px;"/>
                    <Label text="Booking Details"
                           style="-fx-font-size: 15px; -fx-font-weight: bold;
                                  -fx-text-fill: #1B5E20;"/>
                </HBox>

                <!-- Detail rows — alternating tint -->

                <!-- Park -->
                <HBox alignment="CENTER_LEFT" spacing="0"
                      style="-fx-padding: 11 18; -fx-background-color: #FAFFFE;">
                    <Label text="🏕  PARK"
                           style="-fx-font-size: 11px; -fx-font-weight: bold;
                                  -fx-text-fill: #78909C; -fx-min-width: 100;"/>
                    <Label fx:id="lblPark" wrapText="true" HBox.hgrow="ALWAYS"
                           style="-fx-font-size: 13px; -fx-font-weight: bold;
                                  -fx-text-fill: #1A1A1A;"/>
                </HBox>

                <!-- Date + Time (same row) -->
                <HBox alignment="CENTER_LEFT" spacing="0"
                      style="-fx-padding: 11 18; -fx-background-color: white;">
                    <Label text="📅  DATE"
                           style="-fx-font-size: 11px; -fx-font-weight: bold;
                                  -fx-text-fill: #78909C; -fx-min-width: 100;"/>
                    <Label fx:id="lblDate"
                           style="-fx-font-size: 13px; -fx-text-fill: #1A1A1A;
                                  -fx-min-width: 120;"/>
                    <Label text="🕐  TIME"
                           style="-fx-font-size: 11px; -fx-font-weight: bold;
                                  -fx-text-fill: #78909C; -fx-min-width: 80;
                                  -fx-padding: 0 0 0 8;"/>
                    <Label fx:id="lblTime"
                           style="-fx-font-size: 13px; -fx-text-fill: #1A1A1A;"/>
                </HBox>

                <!-- Visitors + Type (same row) -->
                <HBox alignment="CENTER_LEFT" spacing="0"
                      style="-fx-padding: 11 18; -fx-background-color: #FAFFFE;">
                    <Label text="👥  VISITORS"
                           style="-fx-font-size: 11px; -fx-font-weight: bold;
                                  -fx-text-fill: #78909C; -fx-min-width: 100;"/>
                    <Label fx:id="lblVisitors"
                           style="-fx-font-size: 13px; -fx-text-fill: #1A1A1A;
                                  -fx-min-width: 120;"/>
                    <Label text="🏷  TYPE"
                           style="-fx-font-size: 11px; -fx-font-weight: bold;
                                  -fx-text-fill: #78909C; -fx-min-width: 80;
                                  -fx-padding: 0 0 0 8;"/>
                    <Label fx:id="lblType"
                           style="-fx-font-size: 13px; -fx-text-fill: #1A1A1A;"/>
                </HBox>

                <!-- Email -->
                <HBox alignment="CENTER_LEFT" spacing="0"
                      style="-fx-padding: 11 18; -fx-background-color: white;">
                    <Label text="✉  EMAIL"
                           style="-fx-font-size: 11px; -fx-font-weight: bold;
                                  -fx-text-fill: #78909C; -fx-min-width: 100;"/>
                    <Label fx:id="lblEmail" wrapText="true" HBox.hgrow="ALWAYS"
                           style="-fx-font-size: 13px; -fx-text-fill: #1A1A1A;"/>
                </HBox>

                <!-- Note footer -->
                <HBox style="-fx-padding: 11 18 14 18;
                             -fx-border-color: #E8F5E9 transparent transparent transparent;
                             -fx-border-width: 1.5 0 0 0;
                             -fx-background-color: #F9FBF9;
                             -fx-background-radius: 0 0 12 12;">
                    <Label fx:id="lblEmailNote" wrapText="true" HBox.hgrow="ALWAYS"
                           style="-fx-font-size: 11.5px; -fx-text-fill: #546E7A;
                                  -fx-font-style: italic;"/>
                </HBox>
            </VBox>

            <!-- ── Action buttons ───────────────────────────────── -->
            <VBox spacing="10" maxWidth="464">
                <Button text="✔  Done" maxWidth="Infinity"
                        onAction="#handleDone" styleClass="btn-primary"/>
                <Button text="🏕  Book Another Visit" maxWidth="Infinity"
                        onAction="#handleBookAnother" styleClass="btn-teal"/>
            </VBox>

        </VBox>
    </ScrollPane>
</VBox>
