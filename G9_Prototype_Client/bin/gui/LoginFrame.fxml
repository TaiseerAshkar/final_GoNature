<?xml version="1.0" encoding="UTF-8"?>
<?import java.net.URL?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<!--
  LoginFrame.fxml — GoNature redesigned login screen
  All fx:id, onAction, and styleClass references are unchanged.
  Only layout, spacing, and inline-style polish has been added.
-->
<VBox xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="gui.LoginController"
      alignment="CENTER" spacing="0"
      prefWidth="480" prefHeight="640"
      style="-fx-background-color: linear-gradient(to bottom, #E8F5E9 0%, #F0F4F0 42%);">

    <stylesheets>
        <URL value="@gonature.css"/>
    </stylesheets>

    <!-- ── Brand hero ─────────────────────────────────────────── -->
    <VBox alignment="CENTER" spacing="4"
          style="-fx-padding: 52 40 30 40;">

        <!-- Leaf logo mark -->
        <Label text="🌿"
               style="-fx-font-size: 54px; -fx-effect: dropshadow(gaussian, rgba(46,125,50,0.22), 8, 0, 0, 2);"/>

        <!-- App name -->
        <Label text="GoNature" styleClass="login-title"
               style="-fx-font-size: 40px; -fx-font-weight: bold;
                      -fx-text-fill: #1B5E20;
                      -fx-effect: dropshadow(gaussian, rgba(46,125,50,0.16), 3, 0, 0, 1);"/>

        <!-- App subtitle -->
        <Label text="National Park Reservation System"
               style="-fx-font-size: 13px; -fx-text-fill: #546E7A;
                      -fx-padding: 2 0 0 0;"/>
    </VBox>

    <!-- ── Login card ─────────────────────────────────────────── -->
    <VBox spacing="0" styleClass="login-card" maxWidth="400"
          style="-fx-background-radius: 20;
                 -fx-border-radius: 20 20 0 0;
                 -fx-padding: 28 32 32 32;
                 -fx-effect: dropshadow(gaussian, rgba(46,125,50,0.18), 32, 0, 0, 8);
                 -fx-border-width: 4 0 0 0;
                 -fx-border-color: #2E7D32 transparent transparent transparent;">

        <!-- Card heading -->
        <VBox spacing="3" style="-fx-padding: 0 0 18 0;">
            <Label text="Welcome back 👋"
                   style="-fx-font-size: 20px; -fx-font-weight: bold;
                          -fx-text-fill: #1B5E20;"/>
            <Label text="Sign in to manage your reservations."
                   style="-fx-font-size: 12px; -fx-text-fill: #90A4AE;"/>
        </VBox>

        <Separator style="-fx-padding: 0 0 18 0; -fx-opacity: 0.6;"/>

        <!-- Spacer below separator -->
        <Region prefHeight="16"/>

        <!-- ID / Username -->
        <VBox spacing="5" style="-fx-padding: 0 0 14 0;">
            <Label text="ID Number or Username"
                   style="-fx-font-size: 12px; -fx-font-weight: bold;
                          -fx-text-fill: #2E7D32;"/>
            <TextField fx:id="txtIdentifier"
                       promptText="Visitor: enter ID  ·  Staff: enter username"
                       style="-fx-font-size: 13px; -fx-padding: 10 12;
                              -fx-background-color: #FAFAFA;
                              -fx-background-radius: 9; -fx-border-radius: 9;
                              -fx-border-color: #CFD8DC; -fx-border-width: 1.5;
                              -fx-prompt-text-fill: #B0BEC5;"/>
        </VBox>

        <!-- Password -->
        <VBox spacing="5" style="-fx-padding: 0 0 6 0;">
            <Label text="Password"
                   style="-fx-font-size: 12px; -fx-font-weight: bold;
                          -fx-text-fill: #2E7D32;"/>
            <!-- Hidden password (default) -->
            <PasswordField fx:id="txtPassword"
                           promptText="Staff only — leave blank if you are a visitor"
                           style="-fx-font-size: 13px; -fx-padding: 10 12;
                                  -fx-background-color: #FAFAFA;
                                  -fx-background-radius: 9; -fx-border-radius: 9;
                                  -fx-border-color: #CFD8DC; -fx-border-width: 1.5;
                                  -fx-prompt-text-fill: #B0BEC5;"/>
            <!-- Visible password (shown when checkbox is ticked) -->
            <TextField fx:id="txtPasswordVisible"
                       promptText="Staff only — leave blank if you are a visitor"
                       visible="false" managed="false"
                       style="-fx-font-size: 13px; -fx-padding: 10 12;
                              -fx-background-color: #FAFAFA;
                              -fx-background-radius: 9; -fx-border-radius: 9;
                              -fx-border-color: #CFD8DC; -fx-border-width: 1.5;
                              -fx-prompt-text-fill: #B0BEC5;"/>
            <!-- Show / hide toggle -->
            <CheckBox fx:id="chkShowPassword" text="Show password"
                      onAction="#handleShowPassword"
                      style="-fx-font-size: 11px; -fx-text-fill: #546E7A;
                             -fx-cursor: hand; -fx-padding: 2 0 0 2;"/>
            <Label text="Visitors and guides: enter your ID and leave the password blank."
                   styleClass="lbl-hint" wrapText="true"
                   style="-fx-font-size: 11px; -fx-text-fill: #78909C;
                          -fx-padding: 2 0 0 2;"/>
        </VBox>

        <!-- Error message -->
        <Label fx:id="lblError" text="" styleClass="lbl-error" wrapText="true"
               style="-fx-padding: 4 0 0 0; -fx-font-size: 12px;"/>

        <!-- Spacer -->
        <Region prefHeight="10"/>

        <!-- Login button -->
        <Button fx:id="btnLogin" text="Sign In" onAction="#handleLogin"
                styleClass="btn-primary" maxWidth="Infinity"
                style="-fx-font-size: 14px; -fx-font-weight: bold;
                       -fx-padding: 11 22; -fx-background-radius: 10;
                       -fx-cursor: hand;"/>

        <!-- Sign-up row -->
        <HBox alignment="CENTER" spacing="4"
              style="-fx-padding: 14 0 10 0;">
            <Label text="New to GoNature?"
                   style="-fx-font-size: 12px; -fx-text-fill: #78909C;"/>
            <Button text="Create an Account" onAction="#handleSignUp"
                    styleClass="btn-link"
                    style="-fx-font-size: 12px;"/>
        </HBox>

        <Separator style="-fx-opacity: 0.45;"/>

        <!-- Spacer -->
        <Region prefHeight="12"/>

        <!-- Exit button — subordinate styling -->
        <Button text="Exit Application" onAction="#handleExit"
                styleClass="btn-secondary" maxWidth="Infinity"
                style="-fx-font-size: 12px; -fx-padding: 8 22;
                       -fx-opacity: 0.78; -fx-background-radius: 9;
                       -fx-cursor: hand;"/>

    </VBox>

    <!-- Help link -->
    <Label text="Need help?"
           onMouseClicked="#handleHelp" styleClass="help-link"
           style="-fx-padding: 18 0 24 0; -fx-font-size: 12px;
                  -fx-text-fill: #00796B; -fx-underline: true; -fx-cursor: hand;"/>

</VBox>
