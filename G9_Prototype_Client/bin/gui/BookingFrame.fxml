<?xml version="1.0" encoding="UTF-8"?>
<?import java.net.URL?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="gui.BookingController"
      styleClass="screen-bg"
      spacing="0"
      prefWidth="580">

    <stylesheets>
        <URL value="@gonature.css"/>
    </stylesheets>

    <!-- Header bar -->
    <HBox styleClass="header-bar" alignment="CENTER_LEFT" spacing="10">
        <Label text="🌿 GoNature — New Booking" styleClass="header-logo"/>
        <Region HBox.hgrow="ALWAYS"/>
        <Button text="Cancel" onAction="#handleCancel" styleClass="btn-outline"/>
    </HBox>

    <ScrollPane fitToWidth="true" styleClass="scroll-pane" VBox.vgrow="ALWAYS">
        <VBox spacing="16" style="-fx-padding: 24;">

            <!-- ── Visit Details card ──────────────────────── -->
            <VBox spacing="14" styleClass="card">
                <Label text="🏕  Visit Details" styleClass="card-title"/>
                <Separator/>

                <!-- Park selector -->
                <VBox spacing="6">
                    <Label text="Park *" styleClass="field-label"/>
                    <ComboBox fx:id="cboPark" maxWidth="Infinity"
                              promptText="Select a park…"
                              style="-fx-background-color: white;
                                     -fx-background-radius: 8;
                                     -fx-border-color: #B0BEC5;
                                     -fx-border-radius: 8;
                                     -fx-border-width: 1.5;
                                     -fx-font-size: 13px;
                                     -fx-padding: 4 2;"/>
                    <Label fx:id="lblAvailability" wrapText="true"
                           style="-fx-font-size: 12px; -fx-font-weight: bold;"/>
                </VBox>

                <!-- Date + Time row -->
                <HBox spacing="14">
                    <VBox spacing="6" HBox.hgrow="ALWAYS">
                        <Label text="Visit Date *" styleClass="field-label"/>
                        <DatePicker fx:id="dpDate" maxWidth="Infinity"
                                    style="-fx-background-color: white;
                                           -fx-background-radius: 8;
                                           -fx-border-color: #B0BEC5;
                                           -fx-border-radius: 8;
                                           -fx-border-width: 1.5;"/>
                    </VBox>
                    <VBox spacing="6" HBox.hgrow="ALWAYS">
                        <Label text="Visit Time *" styleClass="field-label"/>
                        <ComboBox fx:id="cboTime" maxWidth="Infinity"
                                  promptText="Select time…"
                                  style="-fx-background-color: white;
                                         -fx-background-radius: 8;
                                         -fx-border-color: #B0BEC5;
                                         -fx-border-radius: 8;
                                         -fx-border-width: 1.5;
                                         -fx-font-size: 13px;
                                         -fx-padding: 4 2;"/>
                    </VBox>
                </HBox>

                <!-- Visit type + visitor count row -->
                <HBox spacing="14">
                    <VBox spacing="6" HBox.hgrow="ALWAYS">
                        <Label text="Visit Type *" styleClass="field-label"/>
                        <ComboBox fx:id="cboOrderType" maxWidth="Infinity"
                                  style="-fx-background-color: white;
                                         -fx-background-radius: 8;
                                         -fx-border-color: #B0BEC5;
                                         -fx-border-radius: 8;
                                         -fx-border-width: 1.5;
                                         -fx-font-size: 13px;
                                         -fx-padding: 4 2;"/>
                    </VBox>
                    <VBox spacing="6" HBox.hgrow="ALWAYS">
                        <Label text="Number of Visitors *" styleClass="field-label"/>
                        <TextField fx:id="txtVisitors" promptText="e.g. 1"
                                   style="-fx-background-color: white;
                                          -fx-background-radius: 8;
                                          -fx-border-color: #B0BEC5;
                                          -fx-border-radius: 8;
                                          -fx-border-width: 1.5;
                                          -fx-padding: 8 10; -fx-font-size: 13px;"/>
                        <Label fx:id="lblVisitorHint" styleClass="lbl-hint" wrapText="true"/>
                    </VBox>
                </HBox>
            </VBox>

            <!-- ── Your Information card ────────────────────── -->
            <VBox spacing="14" styleClass="card">
                <Label text="👤  Your Information" styleClass="card-title"/>
                <Separator/>

                <!-- Visitor ID — read-only -->
                <VBox spacing="6">
                    <Label text="Visitor ID" styleClass="field-label"/>
                    <TextField fx:id="txtVisitorId" editable="false"
                               style="-fx-background-color: #F5F5F5;
                                      -fx-background-radius: 8;
                                      -fx-border-color: #E0E0E0;
                                      -fx-border-radius: 8;
                                      -fx-border-width: 1.5;
                                      -fx-padding: 8 10; -fx-font-size: 13px;
                                      -fx-text-fill: #546E7A;"/>
                    <Label text="Filled automatically from your login session."
                           styleClass="lbl-hint"/>
                </VBox>

                <!-- Email -->
                <VBox spacing="6">
                    <Label text="Confirmation Email *" styleClass="field-label"/>
                    <TextField fx:id="txtEmail" promptText="your@email.com"
                               style="-fx-background-color: white;
                                      -fx-background-radius: 8;
                                      -fx-border-color: #B0BEC5;
                                      -fx-border-radius: 8;
                                      -fx-border-width: 1.5;
                                      -fx-padding: 8 10; -fx-font-size: 13px;"/>
                </VBox>
            </VBox>

            <!-- Price estimate -->
            <Label fx:id="lblPriceEstimate" styleClass="lbl-price"
                   style="-fx-padding: 2 0;"/>

            <!-- Error -->
            <Label fx:id="lblError" text="" styleClass="lbl-error" wrapText="true"/>

            <!-- Submit button -->
            <Button fx:id="btnSubmit" text="🔍  Check Availability &amp; Book"
                    onAction="#handleSubmit" maxWidth="Infinity"
                    styleClass="btn-primary"
                    style="-fx-font-size: 14px; -fx-padding: 11 22;
                           -fx-background-radius: 10;"/>

        </VBox>
    </ScrollPane>
</VBox>
