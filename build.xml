<?xml version="1.0" encoding="UTF-8"?>
<!--
  GoNature standalone build.

  Produces two self-contained fat jars that run with a plain `java -jar` (or a
  double-click) with NO module-path flags required:

      dist/client_9_9.jar   (Main-Class: client.ClientLauncher)
      dist/server_9_9.jar   (Main-Class: Server.ServerLauncher)

  How the JavaFX "runtime components are missing" problem is solved:
    1. The Main-Class is a plain launcher that does NOT extend Application
       (ClientLauncher / ServerLauncher). The Java launcher only enforces the
       module-path JavaFX guard when the Main-Class itself extends Application,
       so routing through a plain class bypasses it.
    2. Every JavaFX class is unpacked into the jar (classpath / unnamed module).
    3. The JavaFX native libraries (*.dll) are placed at the ROOT of the jar.
       JavaFX's com.sun.glass.utils.NativeLibLoader, when it cannot find a native
       on java.library.path, falls back to Class.getResourceAsStream("/<lib>.dll")
       and extracts it to its cache dir. Root placement is exactly what that
       fallback expects (same layout as the openjfx "win" classifier jars).

  db.properties is bundled at the jar ROOT (it lives in the server's default
  package) because DBController reads it via getResourceAsStream("/db.properties").

  JavaFX web + media modules (and their natives, incl. the ~33 MB jfxwebkit.dll)
  are intentionally excluded: the app uses neither.
-->
<project name="GoNature" default="all" basedir=".">

    <!-- ===================== source / output layout ===================== -->
    <property name="ocsf.src"       location="OCSF/src"/>
    <property name="shared.src"     location="G9_Shared/src"/>
    <property name="client.dir"     location="G9_Prototype_Client"/>
    <property name="server.dir"     location="G9_Prototype_Server"/>
    <property name="client.src"     location="${client.dir}/src"/>
    <property name="server.src"     location="${server.dir}/src"/>
    <property name="client.lib"     location="${client.dir}/lib"/>
    <property name="server.lib"     location="${server.dir}/lib"/>

    <property name="build"          location="build"/>
    <property name="ocsf.classes"   location="${build}/ocsf-classes"/>
    <property name="shared.classes" location="${build}/shared-classes"/>
    <property name="client.classes" location="${build}/client-classes"/>
    <property name="server.classes" location="${build}/server-classes"/>
    <property name="client.stage"   location="${build}/client-stage"/>
    <property name="server.stage"   location="${build}/server-stage"/>
    <property name="dist"           location="dist"/>

    <!-- JavaFX jars to bundle (web + media excluded: unused, ~40 MB). -->
    <patternset id="jfx.jars">
        <include name="javafx.base.jar"/>
        <include name="javafx.controls.jar"/>
        <include name="javafx.fxml.jar"/>
        <include name="javafx.graphics.jar"/>
        <include name="javafx.swing.jar"/>
    </patternset>

    <!-- JavaFX native dlls to bundle: everything except the web/media natives. -->
    <patternset id="jfx.dlls">
        <include name="*.dll"/>
        <exclude name="jfxwebkit.dll"/>
        <exclude name="jfxmedia.dll"/>
        <exclude name="gstreamer-lite.dll"/>
        <exclude name="fxplugins.dll"/>
        <exclude name="glib-lite.dll"/>
    </patternset>

    <!-- When merging dependency jars, drop signatures / manifests / module-info. -->
    <patternset id="merge.exclude">
        <exclude name="META-INF/*.SF"/>
        <exclude name="META-INF/*.DSA"/>
        <exclude name="META-INF/*.RSA"/>
        <exclude name="META-INF/*.EC"/>
        <exclude name="META-INF/MANIFEST.MF"/>
        <exclude name="module-info.class"/>
    </patternset>

    <!-- ===================== compile classpaths ===================== -->
    <path id="client.compile.cp">
        <fileset dir="${client.lib}/javafx"><patternset refid="jfx.jars"/></fileset>
        <pathelement location="${ocsf.classes}"/>
        <pathelement location="${shared.classes}"/>
    </path>

    <path id="server.compile.cp">
        <fileset dir="${server.lib}/javafx"><patternset refid="jfx.jars"/></fileset>
        <fileset dir="${server.lib}">
            <include name="mysql-connector-j-8.0.33.jar"/>
            <include name="mail-1.4.7.jar"/>
            <include name="activation-1.1.1.jar"/>
        </fileset>
        <pathelement location="${ocsf.classes}"/>
        <pathelement location="${shared.classes}"/>
    </path>

    <!-- ===================== clean ===================== -->
    <target name="clean">
        <delete dir="${build}"/>
        <delete dir="${dist}"/>
    </target>

    <!-- ===================== compile OCSF ===================== -->
    <target name="compile-ocsf">
        <mkdir dir="${ocsf.classes}"/>
        <javac srcdir="${ocsf.src}" destdir="${ocsf.classes}"
               includeantruntime="false" encoding="UTF-8" debug="true">
            <!-- built for the classpath (unnamed module); module-info not wanted -->
            <exclude name="module-info.java"/>
        </javac>
    </target>

    <!-- ===================== compile shared DTOs ===================== -->
    <target name="compile-shared">
        <mkdir dir="${shared.classes}"/>
        <javac srcdir="${shared.src}" destdir="${shared.classes}"
               includeantruntime="false" encoding="UTF-8" debug="true">
            <!-- plain serializable POJOs; no JavaFX/JDBC/OCSF deps -->
            <exclude name="module-info.java"/>
        </javac>
    </target>

    <!-- ===================== compile client ===================== -->
    <target name="compile-client" depends="compile-ocsf,compile-shared">
        <mkdir dir="${client.classes}"/>
        <javac srcdir="${client.src}" destdir="${client.classes}"
               includeantruntime="false" encoding="UTF-8" debug="true">
            <classpath refid="client.compile.cp"/>
            <exclude name="module-info.java"/>
        </javac>
        <!-- bundle non-java resources (fxml, css, images) at their package paths -->
        <copy todir="${client.classes}">
            <fileset dir="${client.src}" excludes="**/*.java"/>
        </copy>
    </target>

    <!-- ===================== compile server ===================== -->
    <target name="compile-server" depends="compile-ocsf,compile-shared">
        <mkdir dir="${server.classes}"/>
        <javac srcdir="${server.src}" destdir="${server.classes}"
               includeantruntime="false" encoding="UTF-8" debug="true">
            <classpath refid="server.compile.cp"/>
            <exclude name="module-info.java"/>
        </javac>
        <!-- bundle non-java resources (fxml, css, db.properties) -->
        <copy todir="${server.classes}">
            <fileset dir="${server.src}" excludes="**/*.java"/>
        </copy>
    </target>

    <!-- ===================== client fat jar ===================== -->
    <target name="jar-client" depends="compile-client">
        <delete dir="${client.stage}"/>
        <mkdir dir="${client.stage}"/>
        <unzip dest="${client.stage}">
            <fileset dir="${client.lib}/javafx"><patternset refid="jfx.jars"/></fileset>
            <patternset refid="merge.exclude"/>
        </unzip>
        <mkdir dir="${dist}"/>
        <jar destfile="${dist}/client_9_9.jar" duplicate="preserve">
            <manifest>
                <attribute name="Main-Class" value="client.ClientLauncher"/>
                <attribute name="Implementation-Title" value="GoNature Client"/>
            </manifest>
            <fileset dir="${client.stage}"/>      <!-- JavaFX classes -->
            <fileset dir="${ocsf.classes}"/>      <!-- OCSF -->
            <fileset dir="${shared.classes}"/>    <!-- shared DTOs (logic package) -->
            <fileset dir="${client.classes}"/>    <!-- app classes + fxml/css -->
            <!-- JavaFX native libs at jar root -->
            <fileset dir="${client.lib}/javafx"><patternset refid="jfx.dlls"/></fileset>
        </jar>
    </target>

    <!-- ===================== server fat jar ===================== -->
    <target name="jar-server" depends="compile-server">
        <delete dir="${server.stage}"/>
        <mkdir dir="${server.stage}"/>
        <unzip dest="${server.stage}">
            <fileset dir="${server.lib}/javafx"><patternset refid="jfx.jars"/></fileset>
            <fileset dir="${server.lib}">
                <include name="mysql-connector-j-8.0.33.jar"/>
                <include name="mail-1.4.7.jar"/>
                <include name="activation-1.1.1.jar"/>
            </fileset>
            <patternset refid="merge.exclude"/>
        </unzip>
        <mkdir dir="${dist}"/>
        <jar destfile="${dist}/server_9_9.jar" duplicate="preserve">
            <manifest>
                <attribute name="Main-Class" value="Server.ServerLauncher"/>
                <attribute name="Implementation-Title" value="GoNature Server"/>
            </manifest>
            <fileset dir="${server.stage}"/>      <!-- JavaFX + JDBC + JavaMail classes -->
            <fileset dir="${ocsf.classes}"/>      <!-- OCSF -->
            <fileset dir="${shared.classes}"/>    <!-- shared DTOs (logic package) -->
            <fileset dir="${server.classes}"/>    <!-- app classes + fxml/css + db.properties (root) -->
            <!-- JavaFX native libs at jar root -->
            <fileset dir="${server.lib}/javafx"><patternset refid="jfx.dlls"/></fileset>
        </jar>
    </target>

    <target name="all" depends="jar-client,jar-server"/>

    <!-- ===================== javadoc (three separate folders) ===================== -->
    <path id="javadoc.full.cp">
        <fileset dir="${client.lib}/javafx"><patternset refid="jfx.jars"/></fileset>
        <fileset dir="${server.lib}">
            <include name="mysql-connector-j-8.0.33.jar"/>
            <include name="mail-1.4.7.jar"/>
            <include name="activation-1.1.1.jar"/>
        </fileset>
        <pathelement location="${ocsf.classes}"/>
        <pathelement location="${shared.classes}"/>
        <pathelement location="${client.classes}"/>
        <pathelement location="${server.classes}"/>
    </path>

    <target name="javadoc" depends="compile-ocsf,compile-shared,compile-client,compile-server">
        <!-- common / shared DTOs -->
        <mkdir dir="${dist}/javadoc/G9_common_JavaDoc"/>
        <javadoc destdir="${dist}/javadoc/G9_common_JavaDoc"
                 access="private" encoding="UTF-8" charset="UTF-8" docencoding="UTF-8"
                 windowtitle="GoNature – Group 9 – Common" failonerror="false">
            <sourcepath><pathelement location="${shared.src}"/></sourcepath>
            <classpath refid="javadoc.full.cp"/>
        </javadoc>

        <!-- client -->
        <mkdir dir="${dist}/javadoc/G9_client_JavaDoc"/>
        <javadoc destdir="${dist}/javadoc/G9_client_JavaDoc"
                 access="private" encoding="UTF-8" charset="UTF-8" docencoding="UTF-8"
                 windowtitle="GoNature – Group 9 – Client" failonerror="false">
            <sourcepath><pathelement location="${client.src}"/></sourcepath>
            <classpath refid="javadoc.full.cp"/>
        </javadoc>

        <!-- server -->
        <mkdir dir="${dist}/javadoc/G9_server_JavaDoc"/>
        <javadoc destdir="${dist}/javadoc/G9_server_JavaDoc"
                 access="private" encoding="UTF-8" charset="UTF-8" docencoding="UTF-8"
                 windowtitle="GoNature – Group 9 – Server" failonerror="false">
            <sourcepath><pathelement location="${server.src}"/></sourcepath>
            <classpath refid="javadoc.full.cp"/>
        </javadoc>
    </target>
</project>
