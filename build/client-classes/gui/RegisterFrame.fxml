<?xml version="1.0" encoding="UTF-8"?>
<?import java.net.URL?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="gui.RegisterController"
      styleClass="screen-bg"
      spacing="0"
      prefWidth="600" prefHeight="780">

    <stylesheets>
        <URL value="@gonature.css"/>
    </stylesheets>

    <!-- Header bar -->
    <HBox styleClass="header-bar" alignment="CENTER_LEFT" spacing="12">
        <Label text="🌿 GoNature" styleClass="header-logo"/>
        <Label text="—  Create Account" styleClass="header-subtitle"/>
        <Region HBox.hgrow="ALWAYS"/>
        <Button fx:id="btnTheme" text="🌙" styleClass="btn-outline"/>
    </HBox>

    <!-- Scrollable form body -->
    <ScrollPane fitToWidth="true" VBox.vgrow="ALWAYS" styleClass="scroll-pane">
        <VBox spacing="16" style="-fx-padding: 24 28;">

            <!-- Personal information card -->
            <VBox spacing="14" styleClass="card">

                <Label text="👤  Personal Information" styleClass="card-title"/>
                <Separator/>

                <GridPane hgap="14" vgap="12">
                    <columnConstraints>
                        <ColumnConstraints minWidth="120" prefWidth="130"/>
                        <ColumnConstraints minWidth="200" hgrow="ALWAYS"/>
                    </columnConstraints>

                    <Label text="ID Number *" styleClass="field-label"
                           GridPane.columnIndex="0" GridPane.rowIndex="0"/>
                    <TextField fx:id="txtIdNumber" promptText="9-digit government ID"
                               style="-fx-background-radius:8; -fx-border-radius:8;
                                      -fx-border-color:-park-border; -fx-border-width:1.5;
                                      -fx-padding:8 10; -fx-font-size:13px;"
                               GridPane.columnIndex="1" GridPane.rowIndex="0"/>

                    <Label text="First Name *" styleClass="field-label"
                           GridPane.columnIndex="0" GridPane.rowIndex="1"/>
                    <TextField fx:id="txtFirstName" promptText="First name"
                               style="-fx-background-radius:8; -fx-border-radius:8;
                                      -fx-border-color:-park-border; -fx-border-width:1.5;
                                      -fx-padding:8 10; -fx-font-size:13px;"
                               GridPane.columnIndex="1" GridPane.rowIndex="1"/>

                    <Label text="Last Name *" styleClass="field-label"
                           GridPane.columnIndex="0" GridPane.rowIndex="2"/>
                    <TextField fx:id="txtLastName" promptText="Last name"
                               style="-fx-background-radius:8; -fx-border-radius:8;
                                      -fx-border-color:-park-border; -fx-border-width:1.5;
                                      -fx-padding:8 10; -fx-font-size:13px;"
                               GridPane.columnIndex="1" GridPane.rowIndex="2"/>

                    <Label text="Email *" styleClass="field-label"
                           GridPane.columnIndex="0" GridPane.rowIndex="3"/>
                    <TextField fx:id="txtEmail" promptText="your@email.com"
                               style="-fx-background-radius:8; -fx-border-radius:8;
                                      -fx-border-color:-park-border; -fx-border-width:1.5;
                                      -fx-padding:8 10; -fx-font-size:13px;"
                               GridPane.columnIndex="1" GridPane.rowIndex="3"/>

                    <Label text="Phone Number *" styleClass="field-label"
                           GridPane.columnIndex="0" GridPane.rowIndex="4"/>
                    <TextField fx:id="txtPhone" promptText="10 digits"
                               style="-fx-background-radius:8; -fx-border-radius:8;
                                      -fx-border-color:-park-border; -fx-border-width:1.5;
                                      -fx-padding:8 10; -fx-font-size:13px;"
                               GridPane.columnIndex="1" GridPane.rowIndex="4"/>
                </GridPane>
            </VBox>

            <!-- Subscriber (Family Member Club) sign-up is intentionally NOT here:
                 per the GoNature spec it is performed by a service representative
                 (see ServiceRepController → "Register Subscriber"). This screen
                 creates a plain visitor account only. -->

            <!-- Error label -->
            <Label fx:id="lblError" text="" styleClass="lbl-error" wrapText="true"/>

            <!-- Action buttons -->
            <HBox spacing="12">
                <Button text="✅  Create Account" onAction="#handleRegister"
                        maxWidth="Infinity" HBox.hgrow="ALWAYS"
                        styleClass="btn-primary"
                        style="-fx-font-size: 14px; -fx-padding: 10 22;"/>
                <Button text="Cancel" onAction="#handleCancel"
                        styleClass="btn-secondary"
                        style="-fx-padding: 10 22;"/>
            </HBox>

        </VBox>
    </ScrollPane>
</VBox>
