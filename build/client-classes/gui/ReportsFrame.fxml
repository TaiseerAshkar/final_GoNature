<?xml version="1.0" encoding="UTF-8"?>
<?import java.net.URL?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.chart.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="gui.ReportsController"
      styleClass="screen-bg"
      spacing="0"
      prefWidth="1020" prefHeight="740">

    <stylesheets>
        <URL value="@gonature.css"/>
    </stylesheets>

    <!-- Header -->
    <HBox styleClass="header-bar" alignment="CENTER_LEFT" spacing="10">
        <Label text="🌿 GoNature — Reports Dashboard" styleClass="header-logo"/>
        <Region HBox.hgrow="ALWAYS"/>
        <Label fx:id="lblManagerName" styleClass="header-subtitle"/>
        <Button fx:id="btnTheme" text="🌙" styleClass="btn-outline"/>
        <Button text="Close" onAction="#handleClose" styleClass="btn-outline"/>
    </HBox>

    <!-- ── Period Selector Bar ──────────────────────────────────────────────── -->
    <HBox spacing="12" alignment="CENTER_LEFT"
          style="-fx-background-color:-park-surface;
                 -fx-padding:10 16;
                 -fx-border-color:transparent transparent -park-border transparent;
                 -fx-border-width:0 0 1.5 0;">
        <Label text="📅  Report Period:" styleClass="field-label"
               style="-fx-font-weight:bold;"/>
        <ComboBox fx:id="cboMonth" prefWidth="132"
                  style="-fx-background-color:-park-surface;
                         -fx-background-radius:8;
                         -fx-border-color:-park-border;
                         -fx-border-radius:8;
                         -fx-border-width:1.5;
                         -fx-font-size:13px;
                         -fx-padding:3 2;"/>
        <ComboBox fx:id="cboYear" prefWidth="90"
                  style="-fx-background-color:-park-surface;
                         -fx-background-radius:8;
                         -fx-border-color:-park-border;
                         -fx-border-radius:8;
                         -fx-border-width:1.5;
                         -fx-font-size:13px;
                         -fx-padding:3 2;"/>
        <Button text="📊  Generate Report" onAction="#handleGenerate"
                styleClass="btn-marker" style="-fx-padding:8 18;"/>
        <Region HBox.hgrow="ALWAYS"/>
        <Label fx:id="lblPeriodBadge" text="Select a period and click Generate"
               styleClass="lbl-hint"/>
    </HBox>

    <!-- Tab pane -->
    <TabPane VBox.vgrow="ALWAYS" tabClosingPolicy="UNAVAILABLE">

        <!-- ── TAB 1: VISITOR REPORT ──────────────────────── -->
        <Tab text="  📈  Visitor Report  ">
            <VBox spacing="12" style="-fx-padding: 16;">

                <!-- Filter bar -->
                <HBox spacing="12" alignment="CENTER_LEFT" styleClass="card"
                      style="-fx-padding: 12 16;">
                    <Label text="Park:" styleClass="field-label"/>
                    <ComboBox fx:id="cboVisitorPark" prefWidth="230"
                              style="-fx-background-color:-park-surface;
                                     -fx-background-radius:8;
                                     -fx-border-color:-park-border;
                                     -fx-border-radius:8;
                                     -fx-border-width:1.5;
                                     -fx-font-size:13px;
                                     -fx-padding:3 2;"/>
                    <Region HBox.hgrow="ALWAYS"/>
                    <Label fx:id="lblVisitorStatus" styleClass="lbl-hint"/>
                    <Button text="🔄  Refresh" onAction="#handleRefreshVisitor"
                            styleClass="btn-blue" style="-fx-padding:8 16;"/>
                </HBox>

                <Label fx:id="lblVisitorError" text="" styleClass="lbl-error" wrapText="true"/>

                <BarChart fx:id="chartVisitors" VBox.vgrow="ALWAYS"
                          animated="false" barGap="2" categoryGap="14"
                          styleClass="chart">
                    <xAxis>
                        <CategoryAxis label="Date" tickLabelRotation="-45"/>
                    </xAxis>
                    <yAxis>
                        <NumberAxis label="Total Visitors" lowerBound="0" autoRanging="true"/>
                    </yAxis>
                </BarChart>

            </VBox>
        </Tab>

        <!-- ── TAB 2: CANCELLATION REPORT ────────────────── -->
        <Tab text="  ❌  Cancellation Report  ">
            <VBox spacing="12" style="-fx-padding: 16;">

                <!-- Filter bar -->
                <HBox spacing="12" alignment="CENTER_LEFT" styleClass="card"
                      style="-fx-padding: 12 16;">
                    <Label text="Park:" styleClass="field-label"/>
                    <ComboBox fx:id="cboCancelPark" prefWidth="230"
                              style="-fx-background-color:-park-surface;
                                     -fx-background-radius:8;
                                     -fx-border-color:-park-border;
                                     -fx-border-radius:8;
                                     -fx-border-width:1.5;
                                     -fx-font-size:13px;
                                     -fx-padding:3 2;"/>
                    <Region HBox.hgrow="ALWAYS"/>
                    <Label fx:id="lblCancelStatus" styleClass="lbl-hint"/>
                    <Button text="🔄  Refresh" onAction="#handleRefreshCancel"
                            styleClass="btn-blue" style="-fx-padding:8 16;"/>
                </HBox>

                <Label fx:id="lblCancelError" text="" styleClass="lbl-error" wrapText="true"/>

                <!-- Day-of-week distribution: average + per-weekday spread -->
                <HBox spacing="10" alignment="CENTER_LEFT">
                    <Label text="📅  Cancellations by day of week" styleClass="field-label"
                           style="-fx-font-weight:bold;"/>
                    <Region HBox.hgrow="ALWAYS"/>
                    <Label fx:id="lblCancelDistStatus" styleClass="lbl-hint"/>
                </HBox>

                <BarChart fx:id="chartCancelDist" prefHeight="240" minHeight="200"
                          animated="false" barGap="2" categoryGap="18"
                          legendVisible="false" styleClass="chart">
                    <xAxis>
                        <CategoryAxis label="Day of Week"/>
                    </xAxis>
                    <yAxis>
                        <NumberAxis label="Cancellations" lowerBound="0" autoRanging="true"/>
                    </yAxis>
                </BarChart>

                <TableView fx:id="tableCancels" VBox.vgrow="ALWAYS" styleClass="table-view">
                    <placeholder>
                        <Label text="No cancelled or no-show orders found for this period."
                               styleClass="lbl-hint" style="-fx-font-style:italic;"/>
                    </placeholder>
                    <columns>
                        <TableColumn fx:id="colCancelId"       text="Order #"    prefWidth="76"/>
                        <TableColumn fx:id="colCancelPark"     text="Park"       prefWidth="180"/>
                        <TableColumn fx:id="colCancelVisitor"  text="Visitor ID" prefWidth="110"/>
                        <TableColumn fx:id="colCancelDate"     text="Date"       prefWidth="100"/>
                        <TableColumn fx:id="colCancelTime"     text="Time"       prefWidth="68"/>
                        <TableColumn fx:id="colCancelType"     text="Type"       prefWidth="100"/>
                        <TableColumn fx:id="colCancelStatus"   text="Status"     prefWidth="100"/>
                        <TableColumn fx:id="colCancelVisitors" text="Visitors"   prefWidth="75"/>
                        <TableColumn fx:id="colCancelCreated"  text="Booked On"  prefWidth="140"/>
                    </columns>
                </TableView>

            </VBox>
        </Tab>

        <!-- ── TAB 3: USAGE REPORT ───────────────────────── -->
        <Tab text="  📊  Usage Report  ">
            <VBox spacing="12" style="-fx-padding: 16;">

                <!-- Info bar -->
                <HBox spacing="12" alignment="CENTER_LEFT" styleClass="card"
                      style="-fx-padding: 12 16;">
                    <Label text="📊  Hourly park usage as % of capacity"
                           styleClass="lbl-hint" style="-fx-font-style:normal;"/>
                    <Region HBox.hgrow="ALWAYS"/>
                    <Label fx:id="lblUsageStatus" styleClass="lbl-hint"/>
                    <Button text="🔄  Refresh" onAction="#handleRefreshUsage"
                            styleClass="btn-blue" style="-fx-padding:8 16;"/>
                </HBox>

                <Label fx:id="lblUsageError" text="" styleClass="lbl-error" wrapText="true"/>

                <LineChart fx:id="chartUsage" VBox.vgrow="ALWAYS"
                           animated="false" createSymbols="true"
                           styleClass="chart">
                    <xAxis>
                        <CategoryAxis label="Hour of Day"/>
                    </xAxis>
                    <yAxis>
                        <NumberAxis label="Capacity (%)" lowerBound="0" upperBound="100"
                                    autoRanging="false" tickUnit="10"/>
                    </yAxis>
                </LineChart>

            </VBox>
        </Tab>

        <!-- ── TAB 4: VISIT DURATION REPORT ──────────────── -->
        <Tab text="  ⏱  Visit Duration  ">
            <VBox spacing="12" style="-fx-padding: 16;">

                <!-- Info bar -->
                <HBox spacing="12" alignment="CENTER_LEFT" styleClass="card"
                      style="-fx-padding: 12 16;">
                    <Label text="⏱  Average visit duration by visitor type"
                           styleClass="lbl-hint" style="-fx-font-style:normal;"/>
                    <Region HBox.hgrow="ALWAYS"/>
                    <Label fx:id="lblDurationStatus" styleClass="lbl-hint"/>
                    <Button text="🔄  Refresh" onAction="#handleRefreshDuration"
                            styleClass="btn-blue" style="-fx-padding:8 16;"/>
                </HBox>

                <Label fx:id="lblDurationError" text="" styleClass="lbl-error" wrapText="true"/>

                <BarChart fx:id="chartDuration" VBox.vgrow="ALWAYS"
                          animated="false" barGap="2" categoryGap="40"
                          legendVisible="false" styleClass="chart">
                    <xAxis>
                        <CategoryAxis label="Visitor Type"/>
                    </xAxis>
                    <yAxis>
                        <NumberAxis label="Avg Duration (hours)" lowerBound="0" autoRanging="true"/>
                    </yAxis>
                </BarChart>

            </VBox>
        </Tab>

    </TabPane>
</VBox>
